# Supabase — get these from: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic — get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# App URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# v3: show "Continue with Microsoft" on the sign-in page. Set to 1 only once the
# Azure provider is set up in Supabase (Authentication → Providers).
NEXT_PUBLIC_MICROSOFT_SIGN_IN=
